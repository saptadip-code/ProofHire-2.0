# Copy this file to backend/.env and edit it:   copy .env.example .env
# backend/.env is ignored by git. NEVER commit it and never put real secrets in this example.
# Real environment variables always win over values in .env.

# --- Database (required) -----------------------------------------------------
# Local (guidebook B7):
DATABASE_URL=mysql+pymysql://proofhire:proofhire@localhost:3306/proofhire?charset=utf8mb4
# On Render: Aiven URI converted to mysql+pymysql://USER:PASS@HOST:PORT/defaultdb
# CA certificate path (relative to backend/). Leave empty locally.
DB_SSL_CA=

# --- App ---------------------------------------------------------------------
# dev or prod. prod hides error detail and rejects '*'/localhost CORS origins.
ENV=dev
# Comma separated. Add the Render static-site URL when deployed.
CORS_ORIGINS=http://localhost:5173

# --- Authentication (Phase 2) ------------------------------------------------
# REQUIRED for /auth/register and /auth/login. Generate your own secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it private: anyone who has it can forge login tokens. In prod it must be 32+ characters.
JWT_SECRET=
# Token lifetime in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440
# bcrypt cost: 12 locally, 10 on Render free CPU if login feels slow (allowed range 4-15)
BCRYPT_ROUNDS=12

# --- First administrator (created at startup if no admin exists yet) ----------
# Leave both empty to create no admin. The password must be 8-72 bytes. Choose your own
# strong value here and keep it out of git. Registration can never create an admin.
ADMIN_EMAIL=admin@proofhire.dev
ADMIN_PASSWORD=

# --- Used from later phases ---------------------------------------------------
# Protects /ml/* POST endpoints. Empty locally.
# REQUIRED when ENV=prod (the /api/v1/ml POST endpoints reject all calls without it). Empty is allowed only in dev.
INTERNAL_API_KEY=
# LLM_* variables belong to the AI/ML teammate (guidebook Part A, A10).

# --- AI/ML explanation (optional; deterministic template works without a key) ---
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=8
