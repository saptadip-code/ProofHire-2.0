# ProofHire AI/ML - LLM explanation settings (Member 1). Merge these lines into backend/.env (never commit real keys).
# Copy of the defaults in guidebook A10. Everything is optional: with no key the app uses the deterministic template.

# The LLM is used only when this is the literal word true (default: off).
LLM_ENABLED=false

# Primary provider: Groq, OpenAI-compatible. Get a free key in the Groq console.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional second provider, tried ONCE when the primary times out, returns HTTP 429/5xx or unusable JSON.
# Used only if both the key and the model are set (pick a currently free open-weight model id ending in :free).
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=450
LLM_TEMPERATURE=0.2
LLM_RPM_LIMIT=20
LLM_CACHE_SIZE=256
LLM_CACHE_TTL_SECONDS=86400

# Offline development with Ollama (open source, OpenAI-compatible): set LLM_ENABLED=true,
# LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=<a model you pulled> and any non-empty LLM_API_KEY (e.g. ollama).
